{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.env*)",
      "Edit(/**/.env*)",
      "Edit(/migrations/Version20260519070000.php)",
      "Edit(/migrations/Version20260519080000.php)",
      "Edit(/migrations/Version20260519090000.php)",
      "Edit(/migrations/Version20260519100000.php)",
      "Edit(/migrations/Version20260519110000.php)",
      "Edit(/migrations/Version20261107100000.php)",
      "Edit(/migrations/Version20261107110000.php)",
      "Edit(/migrations/Version20261108120000.php)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker exec * doctrine:migrations:migrate *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-run-tests.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
